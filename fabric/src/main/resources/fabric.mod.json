{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "ellipog"
    ],
    "contact": {
        "homepage": "https://ellipog.dev/docs/stature/",
        "sources": "https://github.com/ellipog/stature",
        "issues": "https://github.com/ellipog/stature/issues"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.ellipog.stature.fabric.StatureFabric"
        ],
        "client": [
            "dev.ellipog.stature.fabric.StatureFabricClient"
        ]
    },
    "mixins": [
        "stature.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_min_version}",
        "fabric-api": ">=${fabric_api_min_version}",
        "minecraft": "${minecraft_version_range_fabric}",
        "java": ">=${java_version}"
    }
}
